# ================================
# 学趣星球 .gitignore
# ================================

# ========== Laravel ==========
/backend/vendor
/backend/node_modules
/backend/.env
/backend/.env.local
/backend/.env.production
/backend/storage/*
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/bootstrap/cache/*
/backend/public/hot
/backend/public/storage
/backend/public/build
/backend/public/css
/backend/public/js
/backend/public/mix-manifest.json
# 前端构建产物（Docker 构建时重新生成，源文件在 frontend-vue/public/）
/backend/public/assets
/backend/public/favicon.svg
/backend/public/icons.svg
/backend/public/index.html
/backend/public/icons
/backend/coverage.xml
/backend/coverage-html

# ========== Node.js ==========
node_modules/
npm-debug.log
yarn-error.log
# package-lock.json is committed for CI reproducibility

# ========== 微信小程序 ==========
/mini-program/miniprogram_npm/
/mini-program/dist/
/mini-program/.cache/

# ========== IDE ==========
.idea/
.vscode/
*.swp
*.swo
*.bak
*~
.DS_Store
Thumbs.db
desktop.ini

# ========== OS ==========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ========== Docker ==========
docker/data/
docker/volumes/

# ========== 环境配置 ==========
.env
.env.local
.env.*.local
*.local

# ========== 测试 ==========
coverage/
.coverage
htmlcov/
.pytest_cache/
.phpunit.cache/
.php-cs-fixer.cache

# ========== 构建输出 ==========
dist/
build/
out/
*.log

# ========== 其他 ==========
*.pid
*.seed
*.pid.lock
.sass-cache/
*.css.map
*.js.map

# ========== 临时排查文件 ==========
bug_logs.txt
bug_logs/
learnstar.html

.workbuddy/
logs.txt
overview.md
.pet-audit-tmp/

# 角色卡是 generate-cards.mjs 的生成物（唯一真相源在 frontend-vue/src/utils/），
# 不再 git 跟踪；需要时运行：cd frontend-vue && node scripts/generate-cards.mjs
docs/角色卡/

# 宠物同族导出物（与角色卡同源，均可由脚本/数据再生成），不再 git 跟踪：
# - CSV/md 提示词导出：cd frontend-vue && node scripts/generate-pet-prompts-v2.js
docs/宠物AI生图提示词.md
frontend-vue/pet-prompts.csv
docs/角色档案·非人物视觉规格速查.md
backend/.phpunit.result.cache
