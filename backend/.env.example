# ===== 学宠星球 - 环境配置 =====
# 【适用场景】不用 Docker、直接以 Laravel 应用运行（本地开发 / 独立部署）
# 【Docker 部署】请改用仓库根目录的 .env.example（compose 部署变量层），不要用本文件
# 所有功能全免费，无VIP概念

APP_NAME="学宠星球"
APP_ENV=production
APP_KEY=base64:GenerateWithArtisanKeyGenerate
APP_DEBUG=false
APP_URL=https://your-domain.com

# ===== 数据库（支持 SQLite / MySQL/MariaDB / PostgreSQL） =====
# 两段只能有一段生效！默认 SQLite：零依赖，开箱即用（与 Docker 部署默认一致）
# ──────────────────────────────────────────────
# 一、SQLite（默认 · 最简单 · 无需数据库服务）
# ──────────────────────────────────────────────
# 文件数据库，自动创建于 storage/database.sqlite，无需 DB_HOST/DB_PORT
# 适合开发与小型部署（< 500 学生）；全校规模请切换到下方外置数据库段
DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ──────────────────────────────────────────────
# 二、外置 MySQL / MariaDB（全校规模生产推荐）
# ──────────────────────────────────────────────
# 切换方法：注释掉上方 SQLite 段的 6 行 DB_*，再取消下方注释
# 需提前在数据库服务器上手动创建 learnstar 库和账号
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1       # 独立部署填实际地址（Docker 环境用容器名）
# DB_PORT=3306
# DB_DATABASE=learnstar
# DB_USERNAME=learnstar
# DB_PASSWORD=ChangeThisToStrongPassword

# PostgreSQL（当 DB_CONNECTION=pgsql 时使用）
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ===== 缓存 / 会话 / 队列 驱动（独立于数据库配置）=====
# 小规模：保持下方 file / database / null，零外部依赖
# 有 Redis 且全校规模：改为 redis，并填写下方 Redis 区块
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
BROADCAST_DRIVER=null

# ===== Redis（可选 · 不填即不使用 Redis）=====
# ⚠️ REDIS_HOST 留空 = 完全不使用 Redis：排行榜降级走 SQL、缓存走文件，功能不受影响
# 要用 Redis 才填：REDIS_HOST 只填 IP 或域名（不带端口），并把上方驱动改成 redis
# 端口非 6379 / 有密码时才需要填后两行，否则留空即可
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Redis DB分区（启用 Redis 时）
# DB 0: 默认缓存
# DB 1: 排行榜（ZSET）
# DB 2: 会话
# DB 3: 广播队列

# ===== 第三方登录配置 =====
# 微信开放平台（扫码登录Web端）
WECHAT_OPEN_APPID=your_wechat_open_appid
WECHAT_OPEN_SECRET=your_wechat_open_secret

# 微信小程序
WECHAT_MINI_APPID=your_mini_program_appid
WECHAT_MINI_SECRET=your_mini_program_secret

# 企业微信
WECHAT_WORK_CORPID=your_corp_id
WECHAT_WORK_SECRET=your_corp_secret
WECHAT_WORK_AGENTID=your_agent_id

# QQ互联
QQ_APPID=your_qq_appid
QQ_APPKEY=your_qq_appkey

# 人人通空间
RENREN_APPID=your_renren_appid
RENREN_SECRET=your_renren_secret

# ===== 广播（实时推送积分变化到家长端） =====
# 小规模用 null/log；启用 WebSocket 广播时设为 redis（需 Redis）

# ===== 文件存储 =====
FILESYSTEM_DRIVER=local
# 生产环境推荐 OSS/S3
# FILESYSTEM_DRIVER=s3

# ===== Sanctum API认证 =====
SANCTUM_STATEFUL_DOMAINS=your-domain.com

# ===== 学校管理员初始账号 =====
# 部署后第一次运行 db:seed 时自动创建。
# 用户名/密码/姓名/学校/学校代码 都通过 .env 自定义；后续可在管理员后台修改学校信息。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeThisImmediately
INITIAL_ADMIN_NAME=李校长
INITIAL_SCHOOL_NAME=阳光小学
INITIAL_SCHOOL_CODE=learnstar-default

# ===== 日志 =====
LOG_CHANNEL=daily
LOG_LEVEL=info
