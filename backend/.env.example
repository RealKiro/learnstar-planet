# ===== 学宠星球 - 环境配置 =====
# 【适用场景】不用 Docker、直接以 Laravel 应用运行（本地开发 / 独立部署）
# 【Docker 部署】请改用仓库根目录的 .env.example（compose 部署变量层），不要用本文件
# 所有功能全免费，无VIP概念

# ===== 改配置前先看：每项前面的 Emoji 是什么意思 =====
#
#   🔴 必须改 —— 不改会跑不起来，或留下严重安全漏洞（默认密码一定要换！）
#   ❗ 建议改 —— 默认值能用，但建议你按实际情况改一下
#   ✅ 可不动 —— 保持默认即可，只有特殊需求才需要碰
#   🚫 留空即关 —— 空着就是关闭该功能，系统自动降级，不影响正常使用
#
# 👉 只想快速跑起来？只改带 🔴 的几项就够了，其余全部保持原样。

# ✅ 可不动：显示在浏览器标签和页面上的名字
APP_NAME="学宠星球"
# ✅ 可不动：production=正式运行；调试排错时才临时改成 local
APP_ENV=production
# 🔴 必须改：安装后执行一次 php artisan key:generate 自动生成，不能留这个占位值
APP_KEY=base64:GenerateWithArtisanKeyGenerate
# ✅ 可不动：false=不向访客暴露报错详情（正式环境请务必保持 false）
APP_DEBUG=false
# 🔴 必须改：改成你的实际访问地址，如 http://192.168.1.100 或 https://school.example.com
#            （否则扫码登录回调、图片地址都会指向错误位置）
APP_URL=https://your-domain.com
# ✅ 可不动：应用时区，默认东八区。考勤「今日」、今日积分、日报表的日期边界都用它，
#            除非学校不在中国大陆时区，否则不用动
APP_TIMEZONE=Asia/Shanghai

# ===== 数据库（支持 SQLite / MySQL/MariaDB / PostgreSQL） =====
# 两段只能有一段生效！默认 SQLite：零依赖，开箱即用（与 Docker 部署默认一致）
# ──────────────────────────────────────────────
# 一、SQLite（默认 · 最简单 · 无需数据库服务）
# ──────────────────────────────────────────────
# ✅ 可不动：文件数据库，自动创建于 storage/database.sqlite，无需 DB_HOST/DB_PORT
# 适合开发与小型部署（< 500 学生）；全校规模请切换到下方外置数据库段
DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ──────────────────────────────────────────────
# 二、外置 MySQL / MariaDB（全校规模生产推荐）
# ──────────────────────────────────────────────
# 切换方法：注释掉上方 SQLite 段的 6 行 DB_*，再取消下方注释
# 需提前在数据库服务器上手动创建 learnstar 库和账号（🔴 项都要改成你的真实信息）
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1       # 🔴 数据库地址（独立部署填实际 IP，Docker 环境用容器名）
# DB_PORT=3306
# DB_DATABASE=learnstar   # 🔴 库名
# DB_USERNAME=learnstar   # 🔴 用户名
# DB_PASSWORD=ChangeThisToStrongPassword   # 🔴 密码

# PostgreSQL（当 DB_CONNECTION=pgsql 时使用）
# DB_HOST=127.0.0.1       # 🔴 PostgreSQL 地址
# DB_PORT=5432

# ===== 缓存 / 会话 / 队列 驱动（与数据库无关，单独配置）=====
# 这 4 行决定「系统把临时数据放哪儿」。默认值全部存在本机，不需要任何额外服务。
#
#   这一行                 管的是什么                 现在的值 → 含义
#   --------------------   -----------------------    --------------------------
#   CACHE_DRIVER           系统缓存（常用数据加速）    file     → 存在服务器文件里
#   SESSION_DRIVER         家长/教师的登录状态         file     → 存在服务器文件里
#   QUEUE_CONNECTION       后台排队任务（批量导入等）  database → 存在数据库表里
#   BROADCAST_CONNECTION   实时消息推送                null     → 不推送（页面自动刷新）
#
# ✅ 普通部署（500 人以内 / 单机）：下面 4 行一个字都不用改，保持原样即可。
#    （本区块默认全部 ✅ 可不动，只有接 Redis 时才按下面步骤改）
#
# 🔧 只有在并发很高、页面明显变慢时，才需要接 Redis，方法是「两步都要做」：
#
#    第 1 步：把下面 4 行的等号右边改成这样（BROADCAST 建议保持 null 不动）：
#             CACHE_DRIVER=redis
#             SESSION_DRIVER=redis
#             QUEUE_CONNECTION=redis
#             BROADCAST_CONNECTION=null
#
#    第 2 步：再到下面「Redis」区块填写 REDIS_HOST=你的 Redis 地址
#
#    ⚠️ 两步缺一不可：只改第 1 步不填地址 → 系统连不上 Redis 会报错；
#                     只填地址不改第 1 步 → 白填，完全用不上。
#    ⚠️ 改完必须重启 / 重新加载服务才生效。
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=null

# ===== Redis（可选 · 不填就是不用 Redis）=====
# 🚫 留空即关：三行全空 = 完全不使用 Redis。排行榜自动改用数据库查询、缓存走文件，
#    功能一切正常，绝大多数学校不需要动这里。
#
# 🔧 只有在上面把驱动改成了 redis，才需要填这里。照抄下面三行、改掉地址即可：
#             REDIS_HOST=127.0.0.1       ← 只填 IP 或域名
#             REDIS_PORT=                ← 端口是 6379 就留空；不是 6379 才填数字
#             REDIS_PASSWORD=            ← 没密码就留空；有密码才填
#
#    ⚠️ REDIS_HOST 只写地址本身：不要带端口（不是 127.0.0.1:6379）、
#       不要带 http:// 或 redis:// 前缀，端口单独填在下一行。
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Redis DB分区（启用 Redis 时，一般无需修改）
# DB 0: 默认缓存
# DB 1: 排行榜（ZSET）
# DB 2: 会话
# DB 3: 广播队列

# ===== 第三方登录配置（🚫 留空即关 · 可选）=====
# 全部留空 = 不启用对应登录方式，账号密码登录不受影响
# 需要哪一项，就去对应平台申请后填入（各平台申请方式见 README）

# 微信开放平台（扫码登录Web端）
WECHAT_OPEN_APPID=
WECHAT_OPEN_SECRET=

# 微信小程序
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

# 企业微信
WECHAT_WORK_CORPID=
WECHAT_WORK_SECRET=
WECHAT_WORK_AGENTID=

# QQ互联
QQ_APPID=
QQ_APPKEY=

# 人人通空间
RENREN_APPID=
RENREN_SECRET=

# ===== 文件存储 =====
# ✅ 可不动：local=存在服务器本地；想用对象存储再改成 s3 并配置密钥
FILESYSTEM_DRIVER=local
# FILESYSTEM_DRIVER=s3

# ===== Sanctum API认证 =====
# 🔴 必须改：填你的访问域名（不带 http://），如 192.168.1.100 或 school.example.com
SANCTUM_STATEFUL_DOMAINS=your-domain.com

# ===== 学校管理员初始账号 =====
# 部署后第一次运行 db:seed 时自动创建。
# 用户名/密码/姓名/学校/学校代码 都通过 .env 自定义；后续可在管理员后台修改学校信息。
INITIAL_ADMIN_USERNAME=admin
# 🔴 必须改：ChangeThisImmediately 只是提醒你改密码的占位文字，必须先换成强密码
INITIAL_ADMIN_PASSWORD=ChangeThisImmediately
# ❗ 建议改：下面三项是系统里第一所学校和第一个管理员的名字，建议改成你的真实信息
INITIAL_ADMIN_NAME=李校长
INITIAL_SCHOOL_NAME=阳光小学
INITIAL_SCHOOL_CODE=learnstar-default

# ===== 日志 =====
# ✅ 可不动：daily=按天分文件保存；排查问题时可临时把 LOG_LEVEL 改成 debug
LOG_CHANNEL=daily
LOG_LEVEL=info
