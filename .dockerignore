# LearnStar Planet - Docker ignore
# Prevents sending unnecessary files to Docker build context

# ========== Git ==========
.git/
.gitignore
.gitattributes

# ========== Dependencies (installed in build stages) ==========
backend/vendor/
frontend-vue/node_modules/
node_modules/

# ========== Backend dev-only (tests / tooling / runtime, 镜像内不需要) ==========
# 原 backend/.dockerignore（context=backend 时才生效）已并入此处：
# 本项目所有构建上下文都是仓库根，仅此文件生效
backend/tests/
backend/storage/
backend/bootstrap/cache/
backend/phpunit.xml
backend/phpunit.xml.dist
backend/phpstan.neon
backend/.php-cs-fixer.php
backend/.php-cs-fixer-cache
backend/infection.json
backend/infection.json.dist

# ========== IDE & OS ==========
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ========== Build outputs ==========
dist/
build/
frontend-vue/dist/

# ========== Docker ==========
docker/data/
docker/volumes/
*.tar.gz

# ========== Test & Coverage ==========
coverage/
backend/coverage.xml
backend/coverage-html/

# ========== Environment ==========
.env
.env.*
!.env.example
*.log

# ========== Other ==========
mini-program/
pwa/
serverless-analysis.md
logs.txt
