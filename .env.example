# ============================================================
# 学宠星球 环境变量配置
# 【适用场景】Docker 部署（docker-compose 从本目录解析 .env；
#   含 APP_PORT/GITHUB_USERNAME/ADMIN_PASSWORD 等部署专用变量）
# 【Laravel 原生运行】本地开发 / 不用 Docker 的独立部署请用 backend/.env.example
# 复制此文件为 .env 并根据你的数据库类型修改配置
# ============================================================
# ===== 改配置前先看：每项前面的 Emoji 是什么意思 =====
# ============================================================
#
#   🔴 必须改 —— 不改会跑不起来，或留下严重安全漏洞（默认密码一定要换！）
#   ❗ 建议改 —— 默认值能用，但建议你按学校实际情况改一下
#   ✅ 可不动 —— 保持默认即可，只有特殊需求才需要碰
#   🚫 留空即关 —— 空着就是关闭该功能，系统自动降级，不影响正常使用
#
# 👉 只想快速跑起来？只改带 🔴 的几项就够了，其余全部保持原样。
#
# ============================================================
# ===== 基础配置 =====
# ✅ 可不动：显示在浏览器标签和页面上的名字，想改欢迎词可自行修改
APP_NAME=学宠星球
# ✅ 可不动：production=正式运行；调试排错时才临时改成 local
APP_ENV=production
# ✅ 可不动：false=不向访客暴露报错详情（正式环境请务必保持 false）
APP_DEBUG=false
# ============================================================
# 应用访问地址
# ============================================================
#
# APP_URL：协议 + IP/域名，不需要带端口
# APP_PORT：端口号，改端口只改这里
#
# 容器启动时自动拼接，例如：
#   APP_URL=http://192.168.1.100  +  APP_PORT=8080  → http://192.168.1.100:8080
#   APP_URL=http://192.168.1.100  +  APP_PORT=7900  → http://192.168.1.100:7900
#   APP_URL=http://192.168.1.100  +  APP_PORT=80    → http://192.168.1.100（80不拼接）
#
#   本机测试：  APP_URL=http://localhost
#   局域网访问：APP_URL=http://192.168.1.100
# 🔴 必须改：只要不是在本机访问，就必须改成服务器的实际 IP 或域名，
#            否则家长/教师端扫码登录、图片地址都会指向错误位置
APP_URL=http://localhost
# ❗ 建议改：8080 被其他程序占用时改这里（改完用新端口访问）
APP_PORT=8080
# ✅ 可不动：直接用官方预置镜像时保持 realkiro
# 🔴 必须改：如果你 Fork 了仓库自行构建镜像，改成你自己的 GitHub 用户名（必须全小写）
#    （GHCR 镜像路径要求全小写，所以 RealKiro → realkiro）
GITHUB_USERNAME=realkiro
# ============================================================
# ===== 数据库配置 =====
# ============================================================
#
# 三种数据库类型，选择其一（默认 SQLite 内置）：
#
#   类型           DB_CONNECTION   内置/外置                       启动命令
#   ──────────────────────────────────────────────────────────────────────
#   SQLite         sqlite          内置（文件数据库，无需服务）     docker-compose up -d
#   MySQL/MariaDB  mysql           外置（连你自己的数据库服务器）   docker-compose up -d app --no-deps
#   PostgreSQL     pgsql           外置（连你自己的数据库服务器）   docker-compose up -d app --no-deps
#
# 设计说明：为减小默认部署体积，Docker 不内置 MySQL/Redis 容器；全校规模请外接你已有的数据库服务器。
# ──────────────────────────────────────────────────────────
# 一、SQLite（默认 · 最简单 · 无需数据库服务）
# ──────────────────────────────────────────────────────────
# ✅ 可不动：文件数据库，不需要 DB_HOST/DB_PORT，数据库文件自动创建于 storage/database.sqlite
# 适合小型部署（< 500 学生），Docker 默认即此模式（无需 Redis）
DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ──────────────────────────────────────────────────────────
# 二、外置 MySQL / MariaDB（全校规模推荐）
# ──────────────────────────────────────────────────────────
# 切换方法：把上方"一、SQLite"段的 6 行 DB_* 注释掉，再取消下方注释（两段只能有一段生效）。
#          缓存/队列驱动与 Redis 无需改动，见下方独立区块。
# 需提前在你的数据库服务器上手动创建 learnstar 库和账号。
# ▸ 外置 MySQL / MariaDB（启用本段时，下面 6 行的后 5 行 🔴 都必须改成你的真实数据库信息）：
# DB_CONNECTION=mysql
# DB_HOST=192.168.1.50           # 🔴 外部数据库 IP 或域名
# DB_PORT=3306
# DB_DATABASE=learnstar          # 🔴 你手动创建的库名
# DB_USERNAME=root               # 🔴 外部数据库用户名
# DB_PASSWORD=your_password      # 🔴 外部数据库密码（留错连不上，启动会失败）
# （缓存/队列驱动与 Redis 见下方独立区块，与数据库类型无关，此处不再重复配置）
# ──────────────────────────────────────────────────────────
# 三、外置 PostgreSQL
# ──────────────────────────────────────────────────────────
# 需提前在 PG 中手动创建数据库和用户（启用本段时，🔴 项都必须改成你的真实信息）
# DB_CONNECTION=pgsql
# DB_HOST=192.168.1.50           # 🔴 PostgreSQL 地址
# DB_PORT=5432
# DB_DATABASE=learnstar          # 🔴 库名
# DB_USERNAME=learnstar_user     # 🔴 用户名
# DB_PASSWORD=your_pg_password   # 🔴 密码
# 启动：docker-compose up -d app --no-deps

# ============================================================
# ===== 缓存 / 会话 / 队列 驱动（与数据库无关，单独配置）=====
# ============================================================
# 这 4 行决定「系统把临时数据放哪儿」。默认值全部存在本机，不需要任何额外服务。
#
#   这一行                 管的是什么                 现在的值 → 含义
#   --------------------   -----------------------    --------------------------
#   CACHE_DRIVER           系统缓存（常用数据加速）    file     → 存在服务器文件里
#   SESSION_DRIVER         家长/教师的登录状态         file     → 存在服务器文件里
#   QUEUE_CONNECTION       后台排队任务（批量导入等）  database → 存在数据库表里
#   BROADCAST_CONNECTION   实时消息推送                null     → 不推送（页面自动刷新）
#
# ✅ 普通部署（500 人以内 / 单机）：下面 4 行一个字都不用改，保持原样即可。
#    （本区块默认全部 ✅ 可不动，只有接 Redis 时才按下面步骤改）
#
# 🔧 只有在并发很高、页面明显变慢时，才需要接 Redis，方法是「两步都要做」：
#
#    第 1 步：把下面 4 行的等号右边改成这样（BROADCAST 建议保持 null 不动）：
#             CACHE_DRIVER=redis
#             SESSION_DRIVER=redis
#             QUEUE_CONNECTION=redis
#             BROADCAST_CONNECTION=null
#
#    第 2 步：再到下面「Redis」区块填写 REDIS_HOST=你的 Redis 地址
#
#    ⚠️ 两步缺一不可：只改第 1 步不填地址 → 系统连不上 Redis 会报错；
#                     只填地址不改第 1 步 → 白填，完全用不上。
#    ⚠️ 改完必须重启才生效：docker-compose restart app
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=null

# ============================================================
# ===== Redis（可选 · 不填就是不用 Redis）=====
# ============================================================
# 🚫 留空即关：三行全空 = 完全不使用 Redis。排行榜自动改用数据库查询、缓存走文件，
#    功能一切正常，绝大多数学校不需要动这里。
#
# 🔧 只有在上面把驱动改成了 redis，才需要填这里。照抄下面三行、改掉地址即可：
#             REDIS_HOST=192.168.1.20    ← 只填 IP 或域名
#             REDIS_PORT=                ← 端口是 6379 就留空；不是 6379 才填数字
#             REDIS_PASSWORD=            ← 没密码就留空；有密码才填
#
#    ⚠️ REDIS_HOST 只写地址本身：不要带端口（不是 192.168.1.20:6379）、
#       不要带 http:// 或 redis:// 前缀，端口单独填在下一行。
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ===== 超级管理员配置（首次部署时自动创建）=====
# 启动时会自动创建一个默认学校和一个 school_admin 账号
# 密码以 .env 为唯一真相来源：每次重启容器都会把密码同步为 ADMIN_PASSWORD 的值
# 🔴 必须改：admin123456 是公开默认值，谁都能登录你的后台！上线前立刻换成强密码
#           （详见 README「🔐 上线前安全检查」）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
# ❗ 建议改：下面三项会作为系统里第一所学校和第一个管理员的名字，建议改成你学校的真实信息
ADMIN_NAME=系统管理员
ADMIN_SCHOOL_NAME=学宠星球默认学校
ADMIN_SCHOOL_CODE=learnstar-default

# ===== API 机器人账号（供外部系统 REST API 对接，可选）=====
# 拥有本校全部班级的查询与操作权限，供 QQ/微信机器人、课中工具等第三方项目调用：
#   1. POST /api/v1/auth/teacher/login 用 BOT_USERNAME/BOT_PASSWORD 换 token
#   2. 带 Authorization: Bearer <token> 调用 /api/v1/teacher/* 接口
# ❗ 建议改：用不到外部对接（QQ/微信机器人等）就改成 false，账号会被停用、更安全
BOT_ENABLED=true
BOT_USERNAME=api-bot
# 🔴 必须改：BOT_ENABLED=true 时，该账号可操作全部班级，默认密码必须换掉，
#            且不要暴露到公网（详见 README「🔐 上线前安全检查」）
BOT_PASSWORD=learnstar-bot-2026
BOT_NAME=API 机器人
# ⚠️ Redis / 缓存驱动已独立成上方「缓存 / 会话 / 队列 驱动」与「Redis」两个区块，
#    与数据库类型无关；不要在其他地方重复设置，避免两处配置打架。
# ===== AI 功能配置（🚫 留空即关 · 可选）=====
# 支持：qwen / openai / deepseek / moonshot
# 🚫 没有 API Key？没关系！留空即可，所有核心功能照常使用，填了 Key 之后 AI 功能自动启用
AI_PROVIDER=
AI_API_KEY=
AI_API_BASE=
AI_MODEL=qwen-turbo
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
# ===== 第三方登录配置（🚫 留空即关 · 可选）=====
# 全部可留空：不填就是不启用对应的登录方式，账号密码登录不受影响
# 需要哪一项，就去对应平台申请后填入（各平台申请方式见 README）
# 微信公众号
WECHAT_OFFICIAL_APPID=
WECHAT_OFFICIAL_SECRET=
# 企业微信
WECHAT_WORK_CORPID=
WECHAT_WORK_AGENTID=
WECHAT_WORK_SECRET=
# 企业微信 Webhook 回调签名（接收消息/请假推送）
WECHAT_WORK_TOKEN=
WECHAT_WORK_ENCODING_AES_KEY=
# 企业微信审批请假模板 ID（学生请假自动同步）
WECHAT_WORK_LEAVE_TEMPLATE_ID=
# QQ 登录
QQ_APPID=
QQ_APPSECRET=
# 钉钉（扫码登录 + 通讯录导入；backend/config/dingtalk.php 从这里读）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 飞书（扫码登录 + 通讯录导入；backend/config/feishu.php 从这里读）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 人人通空间
RENREN_CLIENT_ID=
RENREN_CLIENT_SECRET=
# ===== 文件上传配置 =====
# ✅ 可不动：local=存在服务器本地；UPLOAD_MAX_SIZE 是单个附件大小上限（单位 MB）
FILESYSTEM_DISK=local
UPLOAD_MAX_SIZE=10
# ===== 邮件配置（🚫 留空即关 · 可选）=====
# 🚫 不发邮件就不用填：留空即可，系统不会尝试发信（仅影响找回密码等邮件功能）
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=学宠星球
