# ============================================================
# 学宠星球 环境变量配置
#【适用场景】Docker 部署（docker-compose 从本目录解析 .env）
#   含 APP_PORT/GITHUB_USERNAME/ADMIN_PASSWORD 等部署专用变量
#【不用 Docker 的本地开发】复制 backend-go/.env.example 为 .env
# 复制此文件为 .env 并根据你的数据库类型修改配置
# ============================================================
# ===== 改配置前先看：每项前面的 Emoji 是什么意思 =====
# ============================================================
#
#   🔴 必须改 —— 不改会留严重安全洞（默认密码一定要换！）
#   ❗ 建议改 —— 默认值能用，但建议你按学校实际情况改一下
#   ✅ 可不动 —— 保持默认即可，只有特殊需求才需要动
#   🚫 留空即关 —— 空着就是关闭该功能，系统自动处理，不影响正常使用
#
# 👉 只想快速跑起来？只改带 🔴 的几项就够了，其余全部保持原样。
#
# ============================================================
# ===== 基础配置 =====
# ============================================================
#
# APP_URL：协议 + IP/域名，不需要带端口
# APP_PORT：端口号，改端口只改这里
#
# 容器启动时自动拼接，例如：
#   APP_URL=http://192.168.1.100  +  APP_PORT=8080  → http://192.168.1.100:8080
#
#   本机测试：  APP_URL=http://localhost
#   局域网访问：APP_URL=http://192.168.1.100
# 🔴 必须改：只要不是在本机访问，就必须改成服务器的实际 IP 或域名，
#            否则家长/教师端扫码登录、图片地址都会指向错误位置
APP_URL=http://localhost
# ❗ 建议改：8080 被其他程序占用时改这里（改完用新端口访问）
APP_PORT=8080
# ✅ 可不动：应用时区，默认东八区。考勤「今日」、今日积分、日报表的日期边界都用它
APP_TIMEZONE=Asia/Shanghai
# ✅ 可不动：直接用官方预置镜像时保持 realkiro
# 🔴 必须改：如果你 Fork 了仓库自行构建镜像，改成你自己的 GitHub 用户名（必须全小写）
GITHUB_USERNAME=realkiro

# ============================================================
# ===== 数据库配置 =====
# ============================================================
#
# 三种数据库类型，选其一（默认 SQLite 内置）：
#
#   类型           DB_DRIVER   内置/外置                      启动命令
#   ─────────────────────────────────────────────────────────────────
#   SQLite         sqlite      内置（文件数据库，无需服务）    docker-compose up -d
#   MySQL/MariaDB  mysql       外置（你自己的数据库服务器）    同上
#   PostgreSQL     postgres    外置（你自己的数据库服务器）   同上
#   ─────────────────────────────────────────────────────────────────
#
# 📌 从旧版（Laravel 后端）升级注意：新版数据库结构不同，旧数据不会自动迁移，
#    升级后是全新空库，需要重新导入教师/学生（积分历史无法带走）。
#
# ── 方式一：SQLite（默认，什么都不用改） ──────────────────
# ✅ 可不动：数据文件在容器 /app/data 卷里，随 Docker 数据卷持久化
DB_DRIVER=sqlite

# ── 方式二：外置 MySQL / MariaDB（全校规模推荐） ──────────
# ❗ 建议改：预计全校推广时一开始就用外置库，避免后期迁移
# 用法：把上面一行 DB_DRIVER=sqlite 注释掉，去掉下面各行行首的 #，填你的服务器信息
#
# DB_DRIVER=mysql
# DB_HOST=192.168.1.50
# DB_PORT=3306
# DB_DATABASE=learnstar
# DB_USERNAME=learnstar
# DB_PASSWORD=你的数据库密码
#
# ── 方式三：外置 PostgreSQL ──────────────────────────────
# 用法同上，DB_DRIVER 改为 postgres，端口默认 5432
#
# DB_DRIVER=postgres
# DB_HOST=192.168.1.50
# DB_PORT=5432
# DB_DATABASE=learnstar
# DB_USERNAME=learnstar
# DB_PASSWORD=你的数据库密码
#
# 💡 进阶：也可以一行 DB_DSN 直填完整连接串（密码含空格/等号等特殊字符时推荐），
#    示例见 backend-go/.env.example。

# ============================================================
# ===== 登录密钥 =====
# ============================================================
#
# ✅ 可不动：留空 = 启动时自动生成随机密钥并保存到数据卷（容器重建不掉登录态）。
#            想自己管理时才填（至少 32 位随机字符串），填了就完全以你为准
JWT_SECRET=

# ============================================================
# ===== 管理员账号（首次启动自动创建） =====
# ============================================================
#
# 🔴 必须改：默认密码 admin123456 任何人都能登录后台。上线前务必改成强密码。
#            且每次重启都以这里的值为准同步（忘了密码 = 改这里后 docker-compose up -d）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
# ❗ 建议改：显示用的姓名 / 默认学校名，按学校实际改
ADMIN_NAME=学校管理员
SCHOOL_NAME=学宠星球
SCHOOL_CODE=learnstar

# ============================================================
# ===== API 机器人账号（外部系统对接，可选） =====
# ============================================================
#
# 🔴 必须改（如果用）：机器人账号拥有本校全部班级的加减分权限，
#                      默认密码必须换。用不上就 BOT_ENABLED=false 停用
BOT_ENABLED=true
BOT_USERNAME=api-bot
BOT_PASSWORD=learnstar-bot-2026
# 🚫 留空即关：显示名，一般不用动
BOT_NAME=API 机器人

# ============================================================
# ===== AI 助教（可选，不配不影响任何核心功能） =====
# ============================================================
#
# 🚫 留空即关：AI 不在 .env 配置——登录管理后台「AI 中心」可视化配置
# （30+ 供应商、API Key、模型、用量与官方余额直查都在后台管理）

# ============================================================
# ===== 第三方平台对接（可选） =====
# ============================================================
#
# 企业微信扫码登录 / 通讯录导入 / 请假同步 / 消息推送。
# 🚫 留空即关：不填就只是登录页不显示对应入口，其余功能完全可用
WECHAT_WORK_CORPID=
WECHAT_WORK_AGENTID=
WECHAT_WORK_SECRET=
# 企微回调验签与 AES 解密（GET|POST /api/v1/wechat-work/callback 用）
WECHAT_WORK_TOKEN=
WECHAT_WORK_ENCODING_AES_KEY=
# 钉钉 / 飞书扫码登录与通讯录导入
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ============================================================
# ===== 运维（可选） =====
# ============================================================
# 🚫 留空即关：管理后台「系统日志」读取的日志文件路径（容器内路径如 /app/logs/app.log）。
#              默认日志走 stdout（docker-compose logs app 查看），后台日志页显示为空
LOG_FILE=
