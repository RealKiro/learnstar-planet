# 学宠星球 Go 后端环境变量示例
# 复制为 .env 后按需修改；所有键均有默认值，不配置也能直接启动。
# Docker 部署时 compose 会直接注入环境变量，无需本文件。

# 服务端口
PORT=8080

# 数据库驱动：sqlite | mysql | postgres（也接受旧键名 DB_CONNECTION；pgsql/postgresql 视为 postgres）
DB_DRIVER=sqlite
# 方式一（推荐，一行搞定）：直接填连接串。
#   SQLite 文件路径（相对启动目录；Docker 里 data 目录挂了数据卷）：
DB_DSN=data/learnstar.db
#   MySQL 示例：DB_DRIVER=mysql，DB_DSN=user:pass@tcp(127.0.0.1:3306)/learnstar?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai
#   PostgreSQL 示例：DB_DRIVER=postgres，DB_DSN=host=127.0.0.1 user=postgres password=pass dbname=learnstar port=5432 sslmode=disable TimeZone=Asia/Shanghai
# 方式二（兼容旧 .env）：不填 DB_DSN，改用分项键，由程序组装连接串——
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=learnstar
#   DB_USERNAME=learnstar
#   DB_PASSWORD=你的数据库密码
# （密码含空格/等号的极端场景请用方式一直填 DB_DSN）

# JWT 令牌签名密钥。
# 留空或保持默认值时，启动会自动生成 64 位随机密钥并保存到
# <数据库同目录>/.jwt_secret（Docker 里即数据卷），容器重建不再全员登出。
# 显式配置则完全以你为准。JWT_EXP_HOURS 是教师/管理员令牌有效期（小时）。
JWT_SECRET=
JWT_EXP_HOURS=72

# 密码哈希成本（默认 10）
BCRYPT_COST=10

# 启动时自动迁移表结构 / 播种默认学校与管理员
AUTO_MIGRATE=true
SEED_ADMIN=true

# 应用时区（影响今日/本周等时间口径）
APP_TIMEZONE=Asia/Shanghai

# SPA 静态资源目录（npm run build:deploy 的输出，默认 public）。
# 留空 = 纯 API 部署（页面全部返回 404，适合前后端分离部署）。
PUBLIC_DIR=public

# 首次启动创建默认学校与管理员（已存在则跳过；管理员密码每次启动从 .env 同步，
# 「忘了密码」= 改这里的 ADMIN_PASSWORD 后重启）
SCHOOL_NAME=学宠星球
SCHOOL_CODE=learnstar
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_NAME=学校管理员

# 可选 API 机器人教师（外部系统对接用），默认关闭；开启后密码每次启动从 .env 同步
BOT_ENABLED=false
BOT_USERNAME=api-bot
BOT_PASSWORD=learnstar-bot-2026
BOT_NAME=API 机器人

# 上传文件落盘目录（学校 LOGO 存于 <UPLOAD_DIR>/schools/，写库路径前缀固定为 /storage/app/uploads）
UPLOAD_DIR=storage/app/uploads

# 系统运维「查看日志」（GET /api/v1/admin/system/logs）读取的日志文件路径。
# Go 端日志默认输出到 stdout、没有日志文件；不配置该项时该接口返回空列表 + 说明性 message。
# 若把日志重定向到文件（如启动命令追加 >> /app/logs/app.log），把路径填在这里即可在后台查看。
LOG_FILE=

# 应用对外地址（用于 `url('/login')` 等价物的默认 redirect_uri，见 GET /api/v1/auth/third-party/auth-url）。
# 不配置时为 http://localhost。
APP_URL=http://localhost

# 第三方登录 / 通讯录（企业微信）。键名与旧 Laravel 配置一致。
WECHAT_WORK_CORPID=
WECHAT_WORK_AGENTID=0
WECHAT_WORK_SECRET=
# 企微回调（GET|POST /api/v1/wechat-work/callback）所需的验签与 AES 解密凭据：
# TOKEN 参与 msg_signature 计算；ENCODING_AES_KEY 为 43 字符串（服务端按 base64(key + "=") 解出 32 字节 AES key）。
# 两项任一为空时回调验签一律返回空字符串。
WECHAT_WORK_TOKEN=
WECHAT_WORK_ENCODING_AES_KEY=
# 企微接口根地址：**仅为测试 / 自建代理留的注入点，生产恒为官方地址**（不配置即 https://qyapi.weixin.qq.com）。
WECHAT_WORK_API_BASE=https://qyapi.weixin.qq.com

# 钉钉 / 飞书（第三方扫码登录按学校配置二选一；键名与旧 Laravel 配置一致）。
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
